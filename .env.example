# ========================================================
# ShopTextManager 环境变量配置模版 (.env.example)
# ========================================================

# 数据库连接参数 (PHP后端 api.php 及 Node后端环境)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="xianyu_db"
DB_USER="root"
DB_PASS="root"

# 服务运行端口 (Node.js 开发环境)
PORT=3000

# CORS 跨域允许来源 (生产环境请设置为你的域名，如 https://shop.example.com)
# CORS_ALLOW_ORIGIN="*"
